{
  "name": "codex-auto-reset",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "cli": "tsx packages/cli/src/index.ts",
    "build": "pnpm -r --sort build",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r --sort typecheck",
    "test": "pnpm build && node --test packages/core/test/*.test.* packages/daemon/test/*.test.* packages/cli/test/*.test.*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
